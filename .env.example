# Copy this file to .env and change what you need.
# Every value below is the default.

# LLM used by RAG: ollama (local) or anthropic (Claude; "claude" works too)
LLM_PROVIDER=ollama
# leave the models unset to use the provider's default:
#   ollama: gemma3:4b (agents: qwen3:4b)   anthropic: claude-haiku-5-5
# LLM_MODEL=gemma3:4b
OLLAMA_HOST=http://localhost:11434
# Claude only: your key from https://console.anthropic.com (keep .env private)
# ANTHROPIC_API_KEY=sk-ant-...

# LLM used by agents (needs tool-calling support)
# AGENT_MODEL=qwen3:4b
AGENT_THINK=true
AGENT_MAX_STEPS=5

# Embeddings
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text

# Chunking: word, character, token, recursive, sentence, paragraph, heading, page
# CHUNK_SIZE and CHUNK_OVERLAP count words (word), tokens (token) or characters
CHUNKER=word
CHUNK_SIZE=150
CHUNK_OVERLAP=30
# token chunker only (needs: pip install "rag-titan[tokens]")
CHUNK_ENCODING=cl100k_base

# Storage, retrieval and generation
# memory: forgotten when Python exits; sqlite: saved in VECTOR_STORE_PATH (index once, ask later)
VECTOR_STORE=memory
VECTOR_STORE_PATH=rag_titan.db
DEDUPE_OVERLAP=0.5      # drop search results that repeat a better one; off to keep all
RERANKER=keyword        # keyword or none
GENERATOR=grounded

# Logging: DEBUG, INFO or WARNING
LOG_LEVEL=INFO
