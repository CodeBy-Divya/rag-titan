# ============================================================
#  Sakhi — Environment Variables
# ============================================================

# ── Required API Keys ────────────────────────────────────────
# Groq API Key for LLM reasoning (llama-3.3-70b-versatile)
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key for multilingual embeddings (qwen/qwen3-embedding-8b)
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Optional Observability ───────────────────────────────────
# LangChain / LangSmith tracing (optional)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=sakhi

# ── Server Configuration ─────────────────────────────────────
PORT=8000
SAKHI_DEBUG=false

# ── CORS Origins (Comma-separated) ───────────────────────────
# Example: ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
